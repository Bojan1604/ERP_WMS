DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wms?schema=public"
AUTH_SECRET="promijenite-me-minimalno-32-znaka-openssl-rand-base64-48"
SESSION_TTL_HOURS="12"
# Javna adresa aplikacije (neobavezno) — QR na naljepnicama tada vodi na punu poveznicu
# (otvara se i kamerom mobitela). Bez nje QR nosi samo putanju /skladiste/<id>, koju prepoznaje skener u aplikaciji.
# APP_URL="https://erp.firma.hr"

# Adresa klijenta za ograničenje pokušaja prijave i popis sesija: koliko posrednika (reverse proxy)
# ispred programa dodaje svoj unos na kraj X-Forwarded-For. Zadano 1 (Caddy iz deploy/).
# "none" = program je izravno na mreži (bez posrednika) — zaglavlju se ne vjeruje (adresa se ne bilježi).
# TRUST_PROXY="1"

# MDM (neobavezno)
# MDM_STORAGE_DIR="D:/erp-wms/mdm"           # aplikacije, datoteke, snimke zaslona i zapisnici uređaja
# MDM_ANDROID_SIGNATURE_CHECKSUM=""           # inače iz agents/dist/android/signature-checksum.txt
# MDM_DEFAULT_COMPANY_ID=""                   # firma za uređaje upisane kodom (zadano: prva firma)

# Sigurnosne kopije i pozadinski poslovi (neobavezno)
# BACKUP_DIR="D:/erp-wms/kopije"              # kopije firmi (zadano: storage/backups) — u Dockeru mapirajte kao volumen
# BACKUP_RESTORE_MAX_MB="256"                # najveća (raspakirana) kopija koja se vraća u programu
# JOBS_DISABLED="1"                           # u ovom procesu ne pokreći automatsko izdavanje rata ni dnevne kopije
