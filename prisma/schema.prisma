// =============================================================================
//  ERP/WMS — podatkovni model
//
//  Načela:
//   * svaka poslovna tablica nosi companyId (više firmi u istoj bazi) i indeks
//     koji počinje njime — upiti su uvijek suženi na firmu
//   * iznosi su Decimal; zbrojevi dokumenata se spremaju na zaglavlje pri
//     svakoj promjeni, pa izvještaji rade agregacijom u bazi, bez učitavanja
//     svih zapisa u memoriju
//   * brojevi dokumenata dodjeljuju se u transakciji iz tablice brojača
//   * povijest uređaja (ItemEvent) i dnevnik promjena (AuditLog) su odvojeni:
//     prvo je poslovna kronologija, drugo tehnički trag tko je što promijenio
// =============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // pg_trgm: pretraga po dijelu teksta (ILIKE '%…%') koristi GIN indeks umjesto čitanja cijele tablice
  extensions = [pg_trgm]
}

// ---------------------------------------------------------------- enumeracije

enum Role {
  ADMIN
  MANAGER
  SALES
  WAREHOUSE
  ACCOUNTANT
  DISTRIBUTOR // vanjski korisnik: vidi samo MDM svoje organizacije i njenih klijenata
  CLIENT // vanjski korisnik: vidi samo MDM uređaje svoje firme
}

// ---------------------------------------------------------------- MDM enumeracije

enum MdmOrgType {
  DISTRIBUTOR
  CUSTOMER
}

enum MdmPlatform {
  ANDROID
  WINDOWS
}

enum MdmDeviceStatus {
  PENDING // agent se javio, čeka upis koda
  ENROLLED
  RETIRED // odjavljen („Forget")
}

enum MdmCommandStatus {
  PENDING
  SENT
  SUCCEEDED
  FAILED
  CANCELLED
  EXPIRED
}

/// Uloga statusa u logici programa. Naziv i boju statusa firma bira sama,
/// ali svaki status pripada jednoj od ovih vrsta.
enum StatusKind {
  IN_STOCK // na skladištu, raspoloživ
  RESERVED // izašao iz skladišta, čeka potvrdu prodaje (račun/ugovor)
  SOLD // prodan
  RENTED // u najmu (vezan uz ugovor)
  SERVICE // pokvaren / na servisu — automatski otvara servisni nalog
  RETURNING // najavljen povrat s terena
  WRITTEN_OFF // otpisan
  OTHER // demo, gratis, kod klijenta, zamjenski…
}

enum InvoiceKind {
  INVOICE // račun
  ADVANCE // račun za predujam
  STORNO // poništava cijeli račun
  CREDIT_NOTE // knjižno odobrenje — umanjuje dio iznosa
}

enum InvoiceType {
  SALE
  RENT
  SERVICE
}

enum InvoiceStatus {
  DRAFT
  ISSUED
}

enum LineKind {
  DEVICE // konkretan uređaj po serijskom broju
  MODEL // model i količina, bez serijskih (ponude)
  SERVICE // usluga iz šifrarnika
  MANUAL // slobodna stavka
}

enum Billing {
  MONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL
  ONCE
}

enum BillingMode {
  IN_ADVANCE // račun na početku razdoblja (1.6. za lipanj)
  IN_ARREARS // račun po isteku razdoblja (1.6. za svibanj)
}

enum ContractStatus {
  ACTIVE
  PAUSED
  EXPIRED
  TERMINATED
}

/// Vrsta ponude: obična ponuda ili predračun (proforma) — predračun ima vlastiti brojač (Series.PROFORMA).
enum QuoteKind {
  QUOTE
  PROFORMA
}

/// Izvor servisnog naloga: upisan u programu ili prijavljen kroz portal za klijente.
enum ServiceSource {
  INTERNAL
  PORTAL
}

enum EmailStatus {
  SENT
  FAILED
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
}

enum OrderStatus {
  DRAFT
  ORDERED
  PARTIAL
  RECEIVED
  CANCELLED
}

enum ReceiptStatus {
  POSTED
  CANCELLED
}

enum ServiceStatus {
  REPORTED
  RECEIVED
  DIAGNOSIS
  AT_SUPPLIER
  REPAIRED
  REPLACED
  WRITTEN_OFF
}

enum Frequency {
  MONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL
}

enum ExpenseSource {
  MANUAL
  RECEIPT
  WRITE_OFF
  SUPPLIER_INVOICE
}

enum RequestKind {
  STATUS_CHANGE
  RECEIVE // skladištar šalje skenirane serijske brojeve na zaprimanje
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentMethod {
  TRANSFER // transakcijski račun (virman)
  CASH // gotovina
  CARD // kartica
  OTHER
}

/// Stanje fiskalizacije računa (CIS za gotovinu/kartice, eRačun/F2.0 za transakcijske).
enum FiscalStatus {
  NOT_REQUIRED
  PENDING
  SENT
  FAILED
}

enum SupplierInvoiceSource {
  MANUAL
  EINVOICE
}

enum SupplierInvoiceStatus {
  RECEIVED
  ACCEPTED
  REJECTED
}

enum StocktakeStatus {
  OPEN
  CLOSED
}

enum Series {
  STOCKTAKE
  INVOICE
  QUOTE
  PROFORMA
  CONTRACT
  ORDER
  RECEIPT
  TRANSFER
  SERVICE
  SUPPLIER_INVOICE
}

// ---------------------------------------------------------------- firma i korisnici

model Company {
  id       String  @id @default(cuid())
  name     String
  oib      String?
  vatId    String?
  address  String?
  zip      String?
  city     String?
  country  String  @default("HR")
  iban     String?
  bank     String?
  email    String?
  phone    String?
  web      String?
  logo     String? // data URL, mali PNG/SVG za ispis dokumenata
  /// Boja naglaska firme (#rrggbb; null = zadana tirkizna) — gumbi, poveznice, oznake (src/domain/brand-colors.ts).
  brandColor String?
  /// Boja lijevog izbornika (#rrggbb; null = zadana).
  menuColor  String?
  currency String  @default("EUR")

  vatRegistered             Boolean @default(true)
  vatRate                   Decimal @default(25) @db.Decimal(5, 2)
  overdueDays               Int     @default(30)
  paymentTermDays           Int     @default(15)
  quoteValidDays            Int     @default(15)
  defaultMarginPct          Decimal @default(35) @db.Decimal(5, 2)
  defaultWarrantyMonths     Int     @default(24)
  rentFallbackPct           Decimal @default(5.5) @db.Decimal(5, 2) // prijedlog najma kao % nabavne
  invoicePremises           String  @default("PP1")
  invoiceDevice             String  @default("1")
  invoiceSeparator          String  @default("/")
  invoiceFooter             String?
  statusChangeNeedsApproval Boolean @default(true)
  /// E-adresa knjigovođe (stranica Knjigovođa: kome se šalje ZIP s računima).
  accountantEmail           String?

  // fiskalizacija i eRačun (priprema — adapteri u src/server/fiscal)
  fiscalEnabled        Boolean @default(false)
  /// TEST (demo okolina CIS-a / posrednika) ili PROD
  fiscalEnv            String  @default("TEST")
  /// Fiskalizacijski certifikat (FINA .p12) i lozinka (šifrirana s AUTH_SECRET).
  fiscalCert           Bytes?
  fiscalCertPassword   String?
  /// Sažetak certifikata: { subject, issuer, validTo, oib }
  fiscalCertInfo       Json?
  /// U sustavu PDV-a za potrebe fiskalizacije (USustPdv).
  fiscalSequenceMode   String  @default("P") // P = na razini poslovnog prostora, N = na razini uređaja
  eInvoiceProvider     String  @default("none") // none | demo | eposlovanje | moj-eracun
  eInvoiceApiKey       String? // šifrirano
  /// Uz poslani eRačun priloži PDF računa (UBL AdditionalDocumentReference).
  eInvoiceAttachPdf    Boolean @default(true)
  /// eIzvještavanje: uplate na poslane eRačune automatski se prijavljuju posredniku.
  eReportingEnabled    Boolean @default(true)
  /// Način plaćanja na eRačunu (UNCL4461): 30 = kreditni transfer, 58 = SEPA kreditni transfer.
  eInvoicePaymentMeans String  @default("30")
  /// Model poziva na broj (HUB3, UBL PaymentID).
  paymentModel         String  @default("HR00")

  // ---- podaci firme (prijenos iz starog programa)
  /// SWIFT/BIC banke — ide na račun uz IBAN (strani kupci).
  swift               String?
  /// Naslov predračuna na dokumentu: Predračun / Proforma / Profaktura.
  proformaTitle       String    @default("Predračun")
  /// Zadani operater kad korisnik koji izdaje račun nema ime/OIB.
  operatorName        String?
  operatorOib         String?
  /// Tekstovi oslobođenja PDV-a za strane kupce (prazno = zadani tekst iz domain/tax).
  vatTextEuGoods      String?
  vatTextEuService    String?
  vatTextThirdGoods   String?
  vatTextThirdService String?
  /// Pravni podaci u podnožju svih dokumenata (temeljni kapital, sud, MBS…).
  legalFooter         String?
  /// Automatsko izdavanje rata najma na dan dospijeća (pozadinski posao, jednom dnevno).
  autoIssueRent       Boolean   @default(false)
  /// Od kada je automatsko izdavanje uključeno — izdaju se samo rate s dospijećem od tog dana (bez zaostataka).
  autoIssueSince      DateTime? @db.Date
  /// PDV po naplaćenoj naknadi (oznaka na računu i UBL-u).
  vatOnPayment        Boolean   @default(false)
  /// Zadane KPD 2025 šifre stavki kad ih nema na stavci/modelu/usluzi.
  kpdRent             String?
  kpdSale             String?
  kpdService          String?
  /// Demo firma — samo takva smije „Vrati demo podatke".
  isDemo              Boolean   @default(false)

  // ---- e-pošta (SMTP, nodemailer)
  smtpHost      String?
  smtpPort      Int?
  /// true = TLS od početka (465); false = STARTTLS ako ga poslužitelj nudi (587/25).
  smtpSecure    Boolean @default(false)
  smtpUser      String?
  /// Lozinka SMTP-a, šifrirana s AUTH_SECRET (encryptSecret iz server/fiscal/crypto).
  smtpPassword  String?
  mailFrom      String?
  mailReplyTo   String?
  /// Skrivena kopija svake poslane poruke na mailFrom.
  mailBccSelf   Boolean @default(false)
  /// Predlošci po vrsti: { invoice: { subject, body }, quote: {...}, proforma, delivery, accountant, reminder }
  mailTemplates Json    @default("{}")

  // ---- sigurnosne kopije
  autoBackup         Boolean   @default(false)
  /// Koliko automatskih kopija se čuva (starije se brišu).
  backupKeep         Int       @default(14)
  /// Podsjetnik na kopiju svakih N dana (0 = isključeno).
  backupReminderDays Int       @default(7)
  lastBackupAt       DateTime?

  emailLogs       EmailLog[]
  portalUsers     PortalUser[]
  userCompanies   UserCompany[]
  fiscalLogs      FiscalLog[]
  stocktakes      Stocktake[]
  mdmOrgs         MdmOrg[]
  mdmDevices      MdmDevice[]
  mdmProfiles     MdmProfile[]
  mdmApps         MdmApp[]
  mdmFiles        MdmFile[]
  mdmEnrollTokens MdmEnrollToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users             User[]
  warehouses        Warehouse[]
  categories        Category[]
  models            DeviceModel[]
  statuses          ItemStatus[]
  services          Service[]
  partners          Partner[]
  items             Item[]
  invoices          Invoice[]
  quotes            Quote[]
  packages          Package[]
  contracts         Contract[]
  purchaseOrders    PurchaseOrder[]
  receipts          GoodsReceipt[]
  supplierInvoices  SupplierInvoice[]
  serviceOrders     ServiceOrder[]
  expenses          Expense[]
  expenseCategories ExpenseCategory[]
  transfers         Transfer[]
  requests          ApprovalRequest[]
  auditLogs         AuditLog[]
  counters          DocumentCounter[]
  itemEvents        ItemEvent[]
  priceAgreements   PriceAgreement[]
  attachments       Attachment[]
  rentOverrides     RentOverride[]
}

/// Trag svake komunikacije s CIS-om ili posrednikom (zahtjev, odgovor, greška).
model FiscalLog {
  id        String   @id @default(cuid())
  companyId String
  invoiceId String?
  kind      String // FISCAL (CIS) | EINVOICE (posrednik) | PAYMENT_REPORT
  ok        Boolean
  request   String?
  response  String?
  error     String?
  at        DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, at])
  @@index([invoiceId])
}

/// Inventura: skeniranje stvarnog stanja i usporedba s evidencijom.
model Stocktake {
  id          String          @id @default(cuid())
  companyId   String
  number      String
  warehouseId String?
  status      StocktakeStatus @default(OPEN)
  note        String?
  createdBy   String?
  startedAt   DateTime        @default(now())
  closedAt    DateTime?
  /// Sažetak pri zatvaranju: { expected, found, missing, extra, wrongWarehouse }
  summary     Json?

  company   Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  warehouse Warehouse?      @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  scans     StocktakeScan[]

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([warehouseId])
}

model StocktakeScan {
  id          String   @id @default(cuid())
  stocktakeId String
  serial      String
  itemId      String?
  scannedAt   DateTime @default(now())
  scannedBy   String?

  stocktake Stocktake @relation(fields: [stocktakeId], references: [id], onDelete: Cascade)

  @@unique([stocktakeId, serial])
  @@index([itemId])
}

model User {
  id              String    @id @default(cuid())
  companyId       String
  email           String    @unique
  name            String
  passwordHash    String
  role            Role
  /// Iznimke od prava uloge: { "warehouse": "edit", "purchasing": "view" }
  permissions     Json      @default("{}")
  /// OIB operatera — obavezan na fiskaliziranom računu (OibOper).
  oib             String?
  /// Vanjski korisnici MDM-a (DISTRIBUTOR, CLIENT) pripadaju jednoj MDM organizaciji.
  mdmOrgId        String?
  active          Boolean   @default(true)
  lastLoginAt     DateTime?
  /// Zadnja aktivnost (osvježava se najviše jednom u minuti) — „tko je prijavljen".
  lastSeenAt      DateTime?
  /// TOTP tajna (base32), šifrirana s AUTH_SECRET; null = 2FA nije postavljena.
  totpSecret      String?
  totpEnabled     Boolean   @default(false)
  /// Rezervni kodovi za 2FA — samo sha256 sažeci; iskorišteni se brišu.
  backupCodes     String[]  @default([])
  /// Zadnji iskorišteni TOTP korak (unix/30) — isti ili stariji kod se ne prihvaća ponovno (replay).
  totpLastStep    Int?
  /// Promjena statusa ide na odobrenje: null = prati postavku firme (statusChangeNeedsApproval).
  requireApproval Boolean?
  /// Smije u opasnu zonu (brisanje prometa / svih podataka). Administrator uvijek smije.
  canDanger       Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  company   Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  mdmOrg    MdmOrg?       @relation(fields: [mdmOrgId], references: [id], onDelete: SetNull)
  sessions  Session[]
  companies UserCompany[]

  @@index([companyId])
  @@index([mdmOrgId])
  @@index([companyId, lastSeenAt])
}

/// Dodatne firme kojima korisnik smije pristupiti (više firmi). `User.companyId` je
/// trenutno odabrana firma — prebacivanje ga mijenja; uloga i prava vrijede u svim firmama.
/// Matična firma korisnika ne mora imati redak ovdje.
model UserCompany {
  userId    String
  companyId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([userId, companyId])
  @@index([companyId])
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  ip        String?
  userAgent String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model DocumentCounter {
  companyId String
  series    Series
  year      Int
  last      Int    @default(0)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([companyId, series, year])
}

// ---------------------------------------------------------------- šifrarnici

model Warehouse {
  id        String  @id @default(cuid())
  companyId String
  name      String
  address   String?
  active    Boolean @default(true)
  sort      Int     @default(0)

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items         Item[]
  receipts      GoodsReceipt[]
  transfersFrom Transfer[]     @relation("TransferFrom")
  transfersTo   Transfer[]     @relation("TransferTo")
  stocktakes    Stocktake[]

  @@unique([companyId, name])
}

model Category {
  id        String @id @default(cuid())
  companyId String
  name      String
  sort      Int    @default(0)

  company Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  models  DeviceModel[]
  items   Item[]

  @@unique([companyId, name])
}

model DeviceModel {
  id             String   @id @default(cuid())
  companyId      String
  categoryId     String?
  brand          String?
  name           String
  code           String? // šifra artikla
  kpd            String? // KPD 2025 klasifikacija za eRačun
  /// KPD za najam ovog modela (prazno = Company.kpdRent).
  kpdRent        String?
  /// Zadane specifikacije novih uređaja ovog modela.
  cpu            String?
  screen         String?
  os             String?
  salePrice      Decimal? @db.Decimal(14, 2) // cijena bez PDV-a; prednost pred izračunom iz marže
  rentPrice      Decimal? @db.Decimal(14, 2) // mjesečni najam
  marginPct      Decimal? @db.Decimal(5, 2)
  warrantyMonths Int?
  minStock       Int      @default(0)
  specs          String? // procesor, ekran, OS…
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  company         Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category        Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  items           Item[]
  priceAgreements PriceAgreement[]
  orderLines      PurchaseOrderLine[]
  invoiceLines    InvoiceLine[]
  quoteLines      QuoteLine[]

  @@unique([companyId, brand, name])
  @@index([companyId, categoryId])
  // indeksi stranih ključeva (brisanje i spajanje bez čitanja cijele tablice)
  @@index([categoryId])
}

model ItemStatus {
  id        String     @id @default(cuid())
  companyId String
  name      String
  kind      StatusKind
  color     String     @default("gray")
  /// Sistemski status — program ga koristi za svoju vrstu, ne može se obrisati.
  system    Boolean    @default(false)
  sort      Int        @default(0)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items   Item[]

  @@unique([companyId, name])
  @@index([companyId, kind])
}

model Service {
  id        String  @id @default(cuid())
  companyId String
  name      String
  unit      String  @default("kom")
  price     Decimal @default(0) @db.Decimal(14, 2)
  kpd       String?
  active    Boolean @default(true)

  company    Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lines      InvoiceLine[]
  quoteLines QuoteLine[]

  @@unique([companyId, name])
}

model ExpenseCategory {
  id        String @id @default(cuid())
  companyId String
  name      String

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@unique([companyId, name])
}

// ---------------------------------------------------------------- partneri

model Partner {
  id                  String   @id @default(cuid())
  companyId           String
  name                String
  oib                 String?
  vatId               String?
  address             String?
  zip                 String?
  city                String?
  country             String   @default("HR") // ISO 3166-1 alfa-2
  email               String?
  phone               String?
  iban                String?
  contactPerson       String?
  isCustomer          Boolean  @default(true)
  isSupplier          Boolean  @default(false)
  /// Isključen iz obračuna: podaci ostaju, ali ne ulaze u izvještaje ni nadzornu ploču.
  excluded            Boolean  @default(false)
  paymentTermDays     Int?
  /// Napomena koja se ističe pri izdavanju računa.
  note                String?
  /// eRačun adresa primatelja „shema:id" (npr. 9934:12345678901); prazno = OIB (shema 9934).
  endpointId          String?
  /// Ručna PDV kategorija (S, AE, E, Z, O) — nadjačava izvedenu iz države; null = automatski.
  vatCategoryOverride String?
  /// Poslovna jedinica kupca (eRačun: DeliveryLocation / BuyerReference).
  branchCode          String?
  branchName          String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  heldItems        Item[]            @relation("ItemHolder")
  suppliedItems    Item[]            @relation("ItemSupplier")
  invoices         Invoice[]
  quotes           Quote[]
  contracts        Contract[]
  orders           PurchaseOrder[]
  receipts         GoodsReceipt[]
  supplierInvoices SupplierInvoice[]
  serviceOrders    ServiceOrder[]
  expenses         Expense[]
  priceAgreements  PriceAgreement[]
  mdmOrgs          MdmOrg[]
  portalUsers      PortalUser[]

  @@index([companyId, name])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Partner_name_trgm_idx")
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin, map: "Partner_email_trgm_idx")
  @@index([companyId, oib])
}

model PriceAgreement {
  id        String   @id @default(cuid())
  companyId String
  partnerId String
  modelId   String
  salePrice Decimal? @db.Decimal(14, 2)
  rentPrice Decimal? @db.Decimal(14, 2)

  company Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  partner Partner     @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  model   DeviceModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@unique([partnerId, modelId])
  @@index([companyId])
  // indeksi stranih ključeva (brisanje i spajanje bez čitanja cijele tablice)
  @@index([modelId])
}

// ---------------------------------------------------------------- uređaji

model Item {
  id             String     @id @default(cuid())
  companyId      String
  serial         String
  /// Razlikovna napomena — obavezna kad isti serijski broj već postoji.
  dupNote        String?
  modelId        String
  statusId       String
  /// Preslika vrste statusa radi brzih upita (sinkronizira servisni sloj).
  state          StatusKind
  warehouseId    String?
  supplierId     String?
  partnerId      String? // kupac / najmoprimac / kod koga je uređaj
  invoiceId      String? // zadnji račun na kojem je uređaj (prodaja ili rata)
  receiptId      String? // primka kojom je zaprimljen
  /// Kategorija po komadu — nadjačava kategoriju modela (null = kategorija modela).
  categoryId     String?
  /// Specifikacije po komadu (zadano s modela pri zaprimanju).
  cpu            String?
  screen         String?
  os             String?
  cost           Decimal    @default(0) @db.Decimal(14, 2)
  salePrice      Decimal?   @db.Decimal(14, 2) // stvarno ostvarena prodajna cijena (neto)
  rentPrice      Decimal?   @db.Decimal(14, 2)
  marginPct      Decimal?   @db.Decimal(5, 2)
  importDate     DateTime?  @db.Date
  issueDate      DateTime?  @db.Date
  warrantyStart  DateTime?  @db.Date
  warrantyMonths Int?
  // izlaz iz skladišta (RESERVED)
  outAt          DateTime?
  outById        String?
  outPartnerId   String?
  outNote        String?
  // otpis
  writeOffDate   DateTime?  @db.Date
  writeOffReason String?
  note           String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  company       Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  model         DeviceModel            @relation(fields: [modelId], references: [id])
  status        ItemStatus             @relation(fields: [statusId], references: [id])
  warehouse     Warehouse?             @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  supplier      Partner?               @relation("ItemSupplier", fields: [supplierId], references: [id], onDelete: SetNull)
  partner       Partner?               @relation("ItemHolder", fields: [partnerId], references: [id], onDelete: SetNull)
  invoice       Invoice?               @relation("ItemLastInvoice", fields: [invoiceId], references: [id], onDelete: SetNull)
  receipt       GoodsReceipt?          @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  category      Category?              @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  contractItem  ContractItem?
  returnedFrom  ReturnedContractItem[]
  events        ItemEvent[]
  invoiceLines  InvoiceLine[]
  quoteLines    QuoteLine[]
  serviceOrders ServiceOrder[]         @relation("ServiceItem")
  replacements  ServiceOrder[]         @relation("ServiceReplacement")
  transferItems TransferItem[]
  rentOverrides RentOverride[]
  mdmDevices    MdmDevice[]
  packageItems  PackageItem[]

  @@index([companyId, serial])
  @@index([serial(ops: raw("gin_trgm_ops"))], type: Gin, map: "Item_serial_trgm_idx")
  @@index([note(ops: raw("gin_trgm_ops"))], type: Gin, map: "Item_note_trgm_idx")
  @@index([dupNote(ops: raw("gin_trgm_ops"))], type: Gin, map: "Item_dupNote_trgm_idx")
  @@index([companyId, state])
  @@index([companyId, modelId])
  @@index([companyId, partnerId])
  @@index([companyId, warehouseId, state])
  @@index([companyId, createdAt])
  // sortiranje i filtri popisa uređaja, izvještaja, marži i portala
  @@index([companyId, importDate])
  @@index([companyId, issueDate])
  // silazno s praznima na kraju (sortiranje „najnoviji prvi"); u migraciji DESC NULLS LAST
  @@index([companyId, importDate(sort: Desc)], map: "Item_companyId_importDate_desc_idx")
  @@index([companyId, issueDate(sort: Desc)], map: "Item_companyId_issueDate_desc_idx")
  @@index([companyId, cost])
  @@index([companyId, state, issueDate])
  @@index([companyId, partnerId, issueDate])
  @@index([companyId, cpu])
  @@index([companyId, screen])
  @@index([companyId, os])
  // indeksi stranih ključeva (brisanje i spajanje bez čitanja cijele tablice)
  @@index([invoiceId])
  @@index([modelId])
  @@index([partnerId])
  @@index([receiptId])
  @@index([statusId])
  @@index([supplierId])
  @@index([warehouseId])
  @@index([categoryId])
}

model ItemEvent {
  id        String   @id @default(cuid())
  companyId String
  itemId    String
  at        DateTime @default(now())
  type      String // RECEIVED, SOLD, RENTED, RETURNED, STATUS, TRANSFER, WRITE_OFF, SERVICE, OUT, EDIT…
  message   String
  refType   String? // invoice, contract, receipt, transfer, service
  refId     String?
  userName  String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  item    Item    @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, at])
  @@index([companyId, at])
}

model Transfer {
  id              String   @id @default(cuid())
  companyId       String
  number          String
  date            DateTime @db.Date
  fromWarehouseId String?
  toWarehouseId   String
  note            String?
  createdBy       String?
  createdAt       DateTime @default(now())

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fromWarehouse Warehouse?     @relation("TransferFrom", fields: [fromWarehouseId], references: [id], onDelete: SetNull)
  toWarehouse   Warehouse      @relation("TransferTo", fields: [toWarehouseId], references: [id])
  items         TransferItem[]

  @@unique([companyId, number])
  @@index([companyId, date])
  // indeksi stranih ključeva (brisanje i spajanje bez čitanja cijele tablice)
  @@index([fromWarehouseId])
  @@index([toWarehouseId])
}

model TransferItem {
  transferId String
  itemId     String

  transfer Transfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  item     Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([transferId, itemId])
  @@index([itemId])
}

model ApprovalRequest {
  id          String        @id @default(cuid())
  companyId   String
  kind        RequestKind
  status      RequestStatus @default(PENDING)
  /// STATUS_CHANGE: { itemIds: string[], statusId: string, note?: string }
  payload     Json
  requestedBy String
  resolvedBy  String?
  resolveNote String?
  createdAt   DateTime      @default(now())
  resolvedAt  DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
}

// ---------------------------------------------------------------- prodaja

model Quote {
  id             String      @id @default(cuid())
  companyId      String
  /// QUOTE = ponuda (Series.QUOTE), PROFORMA = predračun (Series.PROFORMA, naslov iz Company.proformaTitle).
  kind           QuoteKind   @default(QUOTE)
  /// Naslov na dokumentu (predračun): null = Company.proformaTitle.
  title          String?
  number         String
  date           DateTime    @db.Date
  validUntil     DateTime?   @db.Date
  partnerId      String
  status         QuoteStatus @default(DRAFT)
  vatRate        Decimal     @db.Decimal(5, 2)
  discountPct    Decimal     @default(0) @db.Decimal(6, 2)
  discountAmount Decimal     @default(0) @db.Decimal(14, 2)
  netTotal       Decimal     @default(0) @db.Decimal(14, 2)
  vatTotal       Decimal     @default(0) @db.Decimal(14, 2)
  grandTotal     Decimal     @default(0) @db.Decimal(14, 2)
  hideSerials    Boolean     @default(false)
  note           String?
  invoiceId      String?     @unique
  /// Ugovor o najmu nastao iz ponude (stavke najma).
  contractId     String?
  createdBy      String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  company  Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  partner  Partner     @relation(fields: [partnerId], references: [id])
  invoice  Invoice?    @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  contract Contract?   @relation(fields: [contractId], references: [id], onDelete: SetNull)
  lines    QuoteLine[]

  @@unique([companyId, number])
  @@index([companyId, date])
  @@index([companyId, status])
  @@index([companyId, kind, date])
  @@index([contractId])
  // indeksi stranih ključeva (brisanje i spajanje bez čitanja cijele tablice)
  @@index([partnerId])
}

model QuoteLine {
  id          String       @id @default(cuid())
  quoteId     String
  sort        Int          @default(0)
  kind        LineKind
  itemId      String?
  modelId     String?
  serviceId   String?
  description String
  unit        String       @default("kom")
  qty         Decimal      @default(1) @db.Decimal(12, 3)
  unitPrice   Decimal      @default(0) @db.Decimal(14, 2)
  discountPct Decimal      @default(0) @db.Decimal(6, 2)
  netAmount   Decimal      @default(0) @db.Decimal(14, 2)
  /// Vrsta stavke: SALE (prodaja) ili RENT (najam); null = prodaja.
  lineType    InvoiceType?
  /// Najam: mjesečna cijena (unitPrice = monthly za jedan mjesec u ponudi).
  monthly     Decimal?     @db.Decimal(14, 2)

  quote   Quote        @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  item    Item?        @relation(fields: [itemId], references: [id], onDelete: SetNull)
  model   DeviceModel? @relation(fields: [modelId], references: [id], onDelete: SetNull)
  service Service?     @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([quoteId])
  // indeksi stranih ključeva (brisanje i spajanje bez čitanja cijele tablice)
  @@index([itemId])
  @@index([modelId])
  @@index([serviceId])
}

/// Paket (Marže → Paketi): skupina uređaja sa skladišta s ukupnom maržom. Informativan je —
/// iz njega se izrađuje ponuda, predračun ili nacrt računa za kupca (cijena paketa se
/// raspoređuje na uređaje razmjerno preporučenim cijenama).
model Package {
  id        String   @id @default(cuid())
  companyId String
  name      String
  /// Cijena paketa (neto); null = zbroj preporučenih cijena uređaja.
  price     Decimal? @db.Decimal(14, 2)
  note      String?
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items   PackageItem[]

  @@index([companyId, createdAt])
}

model PackageItem {
  packageId String
  itemId    String
  sort      Int    @default(0)

  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  item    Item    @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([packageId, itemId])
  @@index([itemId])
}

model Invoice {
  id                  String        @id @default(cuid())
  companyId           String
  status              InvoiceStatus @default(DRAFT)
  kind                InvoiceKind   @default(INVOICE)
  type                InvoiceType   @default(SALE)
  /// Redni broj u godini — dodjeljuje se pri izdavanju, nikad se ne ponavlja.
  seq                 Int?
  year                Int
  number              String?
  partnerId           String
  date                DateTime      @db.Date
  dueDate             DateTime?     @db.Date
  deliveryDate        DateTime?     @db.Date
  vatRate             Decimal       @db.Decimal(5, 2)
  /// Porezna kategorija (S, AE, K, G, E, O) i razlog oslobođenja za eRačun.
  taxCategory         String        @default("S")
  taxExemptReason     String?
  discountPct         Decimal       @default(0) @db.Decimal(6, 2)
  discountAmount      Decimal       @default(0) @db.Decimal(14, 2)
  /// Neoporezive naknade: [{ kind, label, amount }]
  charges             Json          @default("[]")
  advanceAmount       Decimal       @default(0) @db.Decimal(14, 2)
  /// Preslika postavki firme pri izdavanju (ispis i eRačun izdanog računa ne prate kasnije
  /// promjene postavki); null = nacrt ili stariji račun → vrijede trenutne postavke firme.
  sellerVatRegistered Boolean?
  vatOnPayment        Boolean?
  /// Izvorni račun je storniran (poništen stornom) — nema potraživanja.
  stornoed            Boolean       @default(false)
  // zbrojevi — preračunavaju se pri svakoj izmjeni stavki ili uplata
  netTotal            Decimal       @default(0) @db.Decimal(14, 2)
  vatTotal            Decimal       @default(0) @db.Decimal(14, 2)
  chargesTotal        Decimal       @default(0) @db.Decimal(14, 2)
  grandTotal          Decimal       @default(0) @db.Decimal(14, 2)
  paidTotal           Decimal       @default(0) @db.Decimal(14, 2)
  /// Zbroj izdanih knjižnih odobrenja na ovaj račun (pozitivan iznos).
  creditedTotal       Decimal       @default(0) @db.Decimal(14, 2)
  openAmount          Decimal       @default(0) @db.Decimal(14, 2)
  costTotal           Decimal       @default(0) @db.Decimal(14, 2)
  paidDate            DateTime?     @db.Date
  refInvoiceId        String? // storno/odobrenje → izvorni
  contractId          String?
  period              String? // YYYY-MM — razdoblje najma koje rata pokriva
  /// Račun za najam iz Prodaje: „Zatim naplata prelazi u" — od datuma `rentNextFrom` novi uređaji
  /// s računa prelaze na naplatu `rentNextBilling` (drugo razdoblje plana naplate uređaja).
  rentNextBilling     Billing?
  rentNextFrom        DateTime?     @db.Date
  description         String?
  note                String?
  paymentRef          String? // poziv na broj
  /// Stanje slanja eRačuna: { status, sentAt, id, error }
  eInvoice            Json          @default("{}")
  /// Stanje eRačuna za filtre popisa (preslika iz eInvoice.status i posrednika):
  /// null = nije poslan · SENT · DELIVERED · ACCEPTED · REJECTED · PAID · FISCALIZED (IR, bez slanja) · REPORTED (eIzvještavanje) · ERROR
  eInvoiceStatus      String?
  eInvoiceStatusAt    DateTime?
  /// Kada je račun prijavljen u eIzvještavanje (strani kupac / izvan AMS-a).
  eReportedAt         DateTime?
  paymentMethod       PaymentMethod @default(TRANSFER)
  /// Zaštitni kod izdavatelja i jedinstveni identifikator računa (CIS).
  zki                 String?
  jir                 String?
  fiscalStatus        FiscalStatus  @default(NOT_REQUIRED)
  fiscalizedAt        DateTime?
  fiscalError         String?
  fiscalAttempts      Int           @default(0)
  createdBy           String?
  issuedBy            String?
  issuedAt            DateTime?
  /// Kada je račun predan knjigovođi (stranica Knjigovođa); null = nije poslan.
  accountantSentAt    DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  partner       Partner        @relation(fields: [partnerId], references: [id])
  contract      Contract?      @relation(fields: [contractId], references: [id], onDelete: SetNull)
  refInvoice    Invoice?       @relation("InvoiceCorrections", fields: [refInvoiceId], references: [id], onDelete: SetNull)
  corrections   Invoice[]      @relation("InvoiceCorrections")
  lines         InvoiceLine[]
  payments      Payment[]
  items         Item[]         @relation("ItemLastInvoice")
  quote         Quote?
  serviceOrders ServiceOrder[]
  /// Konačni račun: uračunati predujmovi.
  advanceUses   AdvanceUse[]   @relation("AdvanceUseInvoice")
  /// Račun za predujam: konačni računi u koje je uračunat.
  advanceUsedBy AdvanceUse[]   @relation("AdvanceUseAdvance")

  @@unique([companyId, year, seq])
  @@index([companyId, date])
  @@index([companyId, partnerId])
  @@index([companyId, status, kind])
  @@index([companyId, openAmount])
  @@index([contractId, period])
  @@index([companyId, accountantSentAt])
  @@index([companyId, eInvoiceStatus])
  @@index([companyId, dueDate])
  // indeksi stranih ključeva (brisanje i spajanje bez čitanja cijele tablice)
  @@index([partnerId])
  @@index([refInvoiceId])
}

/// Predujam uračunat u konačni račun (iznos s PDV-om). Zbroj po računu predujma ne smije
/// premašiti njegov iznos (nestornirani računi); zbroj po konačnom računu = Invoice.advanceAmount.
model AdvanceUse {
  id        String   @id @default(cuid())
  invoiceId String
  advanceId String
  amount    Decimal  @db.Decimal(14, 2)
  createdAt DateTime @default(now())

  invoice Invoice @relation("AdvanceUseInvoice", fields: [invoiceId], references: [id], onDelete: Cascade)
  advance Invoice @relation("AdvanceUseAdvance", fields: [advanceId], references: [id], onDelete: Cascade)

  @@unique([invoiceId, advanceId])
  @@index([invoiceId])
  @@index([advanceId])
}

model InvoiceLine {
  id             String       @id @default(cuid())
  invoiceId      String
  sort           Int          @default(0)
  kind           LineKind
  itemId         String?
  modelId        String?
  serviceId      String?
  description    String
  unit           String       @default("kom")
  kpd            String?
  qty            Decimal      @default(1) @db.Decimal(12, 3)
  /// Kod najma: mjesečna cijena; unitPrice = monthly × mjeseci naplate.
  monthly        Decimal?     @db.Decimal(14, 2)
  months         Int?
  unitPrice      Decimal      @default(0) @db.Decimal(14, 2)
  discountPct    Decimal      @default(0) @db.Decimal(6, 2)
  netAmount      Decimal      @default(0) @db.Decimal(14, 2)
  /// Nabavna vrijednost u trenutku prodaje (za maržu).
  cost           Decimal      @default(0) @db.Decimal(14, 2)
  warrantyMonths Int?
  agreedPrice    Boolean      @default(false)
  /// Vrsta stavke na miješanom računu: SALE ili RENT (null = prati Invoice.type).
  lineType       InvoiceType?

  invoice Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  item    Item?        @relation(fields: [itemId], references: [id], onDelete: SetNull)
  model   DeviceModel? @relation(fields: [modelId], references: [id], onDelete: SetNull)
  service Service?     @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([itemId])
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin, map: "InvoiceLine_description_trgm_idx")
  // indeksi stranih ključeva (brisanje i spajanje bez čitanja cijele tablice)
  @@index([modelId])
  @@index([serviceId])
}

model Payment {
  id        String   @id @default(cuid())
  invoiceId String
  date      DateTime @db.Date
  amount    Decimal  @db.Decimal(14, 2)
  method    String?
  note      String?
  createdBy String?
  createdAt DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

// ---------------------------------------------------------------- najam

model Contract {
  id               String         @id @default(cuid())
  companyId        String
  number           String
  partnerId        String
  status           ContractStatus @default(ACTIVE)
  startDate        DateTime       @db.Date
  endDate          DateTime?      @db.Date
  firstBillingDate DateTime?      @db.Date
  billingDay       Int?
  billing          Billing        @default(MONTHLY)
  billingMode      BillingMode    @default(IN_ADVANCE)
  seasonFrom       Int? // 1–12
  seasonTo         Int?
  terminatedAt     DateTime?      @db.Date
  /// Raskinut ili označen kao istekao u programu: neizdane rate do kraja ugovora i dalje se traže.
  closedAt         DateTime?      @db.Date
  /// Početak pauze (status PAUSED) — pri nastavku rate dospjele u pauzi idu u `paused` uređaja.
  pausedSince      DateTime?      @db.Date
  note             String?
  createdBy        String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  company       Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  partner       Partner                @relation(fields: [partnerId], references: [id])
  items         ContractItem[]
  returnedItems ReturnedContractItem[]
  invoices      Invoice[]
  quotes        Quote[]

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([companyId, partnerId])
  @@index([companyId, startDate])
  @@index([companyId, endDate])
  // indeksi stranih ključeva (brisanje i spajanje bez čitanja cijele tablice)
  @@index([partnerId])
}

/// Uređaj na ugovoru s vlastitom mjesečnom cijenom i planom naplate.
model ContractItem {
  id          String          @id @default(cuid())
  contractId  String
  itemId      String          @unique // uređaj može biti na samo jednom ugovoru
  monthly     Decimal         @db.Decimal(14, 2)
  /// Plan naplate: [{ from, to?, billing, price?, seasonFrom?, seasonTo? }] — prazno = uvjeti ugovora
  plan        Json            @default("[]")
  /// Pauza ili raskid za pojedini uređaj (null = prati ugovor).
  status      ContractStatus?
  /// Razdoblja (YYYY-MM) koja se ne fakturiraju — izdana izvan programa.
  skipped     String[]        @default([])
  /// Pauzirana razdoblja (YYYY-MM): rata se ne naplaćuje.
  paused      String[]        @default([])
  /// Početak pauze uređaja (status PAUSED) — pri nastavku rate dospjele u pauzi idu u `paused`.
  pausedSince DateTime?       @db.Date
  addedAt     DateTime        @default(now())

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  item     Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([contractId])
}

/// Uređaj skinut s ugovora (povrat, prodaja, servis…): uvjeti se čuvaju da se
/// rate do datuma skidanja koje još nisu izdane i dalje mogu fakturirati.
model ReturnedContractItem {
  id         String   @id @default(cuid())
  contractId String
  itemId     String
  monthly    Decimal  @db.Decimal(14, 2)
  plan       Json     @default("[]")
  skipped    String[] @default([])
  paused     String[] @default([])
  /// Zadnji dan u najmu — naplata staje s tim datumom.
  endDate    DateTime @db.Date
  createdAt  DateTime @default(now())

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  item     Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@index([itemId])
}

/// Ručni upis u mrežu najma (prednost pred izračunom).
model RentOverride {
  companyId String
  itemId    String
  year      Int
  month     Int // 1–12
  amount    Decimal @db.Decimal(14, 2)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  item    Item    @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([itemId, year, month])
  @@index([companyId, year])
}

// ---------------------------------------------------------------- nabava

model PurchaseOrder {
  id                      String      @id @default(cuid())
  companyId               String
  number                  String
  supplierId              String
  date                    DateTime    @db.Date
  expectedDate            DateTime?   @db.Date
  status                  OrderStatus @default(DRAFT)
  total                   Decimal     @default(0) @db.Decimal(14, 2)
  note                    String?
  // račun dobavljača upisan na narudžbenici (nakon primke postaje ulazni račun)
  supplierInvoiceNo       String?
  supplierInvoiceDate     DateTime?   @db.Date
  supplierInvoiceDueDate  DateTime?   @db.Date
  supplierInvoiceCurrency String?
  supplierInvoiceNet      Decimal?    @db.Decimal(14, 2)
  supplierInvoiceVat      Decimal?    @db.Decimal(14, 2)
  supplierInvoiceTotal    Decimal?    @db.Decimal(14, 2)
  createdBy               String?
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  company          Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier         Partner             @relation(fields: [supplierId], references: [id])
  lines            PurchaseOrderLine[]
  receipts         GoodsReceipt[]
  supplierInvoices SupplierInvoice[]

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([companyId, date])
  // indeksi stranih ključeva (brisanje i spajanje bez čitanja cijele tablice)
  @@index([supplierId])
}

model PurchaseOrderLine {
  id       String  @id @default(cuid())
  orderId  String
  modelId  String
  qty      Int
  unitCost Decimal @default(0) @db.Decimal(14, 2)
  received Int     @default(0)

  order PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  model DeviceModel   @relation(fields: [modelId], references: [id])

  @@index([orderId])
  // indeksi stranih ključeva (brisanje i spajanje bez čitanja cijele tablice)
  @@index([modelId])
}

model GoodsReceipt {
  id                String        @id @default(cuid())
  companyId         String
  number            String
  date              DateTime      @db.Date
  supplierId        String?
  orderId           String?
  warehouseId       String
  supplierDocNumber String?
  status            ReceiptStatus @default(POSTED)
  total             Decimal       @default(0) @db.Decimal(14, 2)
  note              String?
  createdBy         String?
  createdAt         DateTime      @default(now())

  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier         Partner?          @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  order            PurchaseOrder?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  warehouse        Warehouse         @relation(fields: [warehouseId], references: [id])
  items            Item[]
  expense          Expense?
  supplierInvoices SupplierInvoice[]

  @@unique([companyId, number])
  @@index([companyId, date])
  // indeksi stranih ključeva (brisanje i spajanje bez čitanja cijele tablice)
  @@index([orderId])
  @@index([supplierId])
  @@index([warehouseId])
}

/// Ulazni račun dobavljača (knjiga URA).
model SupplierInvoice {
  id               String                @id @default(cuid())
  companyId        String
  internalNo       String
  number           String // broj računa dobavljača
  supplierId       String
  issueDate        DateTime              @db.Date
  dueDate          DateTime?             @db.Date
  netAmount        Decimal               @default(0) @db.Decimal(14, 2)
  vatAmount        Decimal               @default(0) @db.Decimal(14, 2)
  total            Decimal               @default(0) @db.Decimal(14, 2)
  paidDate         DateTime?             @db.Date
  category         String?
  note             String?
  /// Kada je račun predan knjigovođi (stranica Knjigovođa); null = nije poslan.
  accountantSentAt DateTime?
  /// Upisan ručno ili preuzet kao eRačun od informacijskog posrednika (Fiskalizacija 2.0).
  source           SupplierInvoiceSource @default(MANUAL)
  /// Poslovni status kupca. Zadano ACCEPTED: ručni i postojeći računi su već „prihvaćeni" upisom;
  /// samo preuzeti eRačun počinje kao RECEIVED i čeka odluku (prihvati / odbij).
  status           SupplierInvoiceStatus @default(ACCEPTED)
  statusAt         DateTime?
  statusBy         String?
  rejectReason     String?
  /// Id dokumenta kod posrednika (samo eRačun); jedinstven po firmi.
  eInvoiceId       String?
  /// Okruženje posrednika iz kojeg je dokument preuzet (TEST | PROD).
  eInvoiceEnv      String?
  /// Zadnji status koji je posrednik javio (sirovi tekst, za prikaz).
  providerStatus   String?
  /// Veza s nabavom: narudžbenica i/ili primka iz koje je račun nastao.
  orderId          String?
  receiptId        String?
  /// Dobavljač kako je upisan/pročitan (naziv, OIB) — partner se otvara pri knjiženju ako ga nema.
  supplierName     String?
  supplierOib      String?
  /// Stopa PDV-a (za prikaz stupca PDV %); null = izračun iz iznosa.
  vatPct           Decimal?              @db.Decimal(5, 2)
  currency         String                @default("EUR")
  /// „Ovo je račun za robu s primke" (trošak robe nosi primka): true/false = odluka (izričita ili
  /// po pravilu iznosa pri spremanju), null = račun nije povezan s nabavom.
  goodsInvoice     Boolean?
  /// „Knjiži kao trošak" — odluka korisnika (kvačica obrasca, prihvaćanje eRačuna, „Knjiži ponovno").
  /// Koliko se stvarno knjiži određuje usklađivanje po narudžbenici (reconcileOrderGoodsExpense).
  bookExpense      Boolean               @default(true)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  company  Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier Partner        @relation(fields: [supplierId], references: [id])
  order    PurchaseOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  receipt  GoodsReceipt?  @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  expense  Expense?

  @@unique([companyId, internalNo])
  // više NULL-ova je dopušteno (ručni računi), a eRačun se ne može upisati dvaput
  @@unique([companyId, eInvoiceId])
  @@index([companyId, issueDate])
  @@index([companyId, accountantSentAt])
  @@index([companyId, status])
  // indeksi stranih ključeva (brisanje i spajanje bez čitanja cijele tablice)
  @@index([supplierId])
  @@index([orderId])
  @@index([receiptId])
}

// ---------------------------------------------------------------- servis

model ServiceOrder {
  id                String        @id @default(cuid())
  companyId         String
  number            String
  itemId            String?
  serial            String?
  partnerId         String?
  invoiceId         String?
  status            ServiceStatus @default(RECEIVED)
  reportedAt        DateTime      @db.Date
  receivedAt        DateTime?     @db.Date
  closedAt          DateTime?     @db.Date
  issue             String
  diagnosis         String?
  action            String?
  solution          String?
  replacementItemId String?
  cost              Decimal       @default(0) @db.Decimal(14, 2)
  underWarranty     Boolean       @default(true)
  publicNote        String?
  note              String?
  /// Tijek: [{ at, status, by, note }]
  timeline          Json          @default("[]")
  /// Upisan u programu ili prijavljen kroz portal (status REPORTED).
  source            ServiceSource @default(INTERNAL)
  /// Portal: korisnik koji je prijavio kvar i kontakt koji je upisao.
  portalUserId      String?
  contact           String?
  createdBy         String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  item        Item?       @relation("ServiceItem", fields: [itemId], references: [id], onDelete: SetNull)
  replacement Item?       @relation("ServiceReplacement", fields: [replacementItemId], references: [id], onDelete: SetNull)
  partner     Partner?    @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  invoice     Invoice?    @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  portalUser  PortalUser? @relation(fields: [portalUserId], references: [id], onDelete: SetNull)

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([companyId, reportedAt])
  @@index([companyId, partnerId, reportedAt])
  @@index([companyId, source, status])
  @@index([portalUserId])
  @@index([itemId])
  // indeksi stranih ključeva (brisanje i spajanje bez čitanja cijele tablice)
  @@index([invoiceId])
  @@index([partnerId])
  @@index([replacementItemId])
}

// ---------------------------------------------------------------- troškovi

model Expense {
  id                String        @id @default(cuid())
  companyId         String
  date              DateTime      @db.Date
  categoryId        String?
  description       String
  partnerId         String?
  netAmount         Decimal       @default(0) @db.Decimal(14, 2)
  vatAmount         Decimal       @default(0) @db.Decimal(14, 2)
  paid              Boolean       @default(false)
  paidDate          DateTime?     @db.Date
  frequency         Frequency?
  recurringUntil    DateTime?     @db.Date
  /// Izmjene pojedinih rata ponavljajućeg troška: { "2026-03": { amount?: n, skipped?: true } }
  overrides         Json          @default("{}")
  source            ExpenseSource @default(MANUAL)
  receiptId         String?       @unique
  supplierInvoiceId String?       @unique
  note              String?
  createdBy         String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category        ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  partner         Partner?         @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  receipt         GoodsReceipt?    @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  supplierInvoice SupplierInvoice? @relation(fields: [supplierInvoiceId], references: [id], onDelete: SetNull)

  @@index([companyId, date])
  @@index([companyId, categoryId])
  // indeksi stranih ključeva (brisanje i spajanje bez čitanja cijele tablice)
  @@index([categoryId])
  @@index([partnerId])
}

// ---------------------------------------------------------------- prilozi i dnevnik

model Attachment {
  id        String   @id @default(cuid())
  companyId String
  entity    String // vidi ATTACHMENT_ENTITIES (server/services/attachments.ts)
  entityId  String
  fileName  String
  mime      String
  size      Int
  data      Bytes
  /// Vidljivo klijentu na portalu (fotografije prijave kvara s portala; osoblje uključuje po prilogu servisnog naloga).
  public    Boolean  @default(false)
  createdBy String?
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, entity, entityId])
}

model AuditLog {
  id        String   @id @default(cuid())
  companyId String
  at        DateTime @default(now())
  userId    String?
  userName  String?
  entity    String
  entityId  String?
  action    String // create, update, delete, issue, storno, …
  summary   String
  diff      Json?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, at])
  @@index([companyId, entity, entityId])
}

/// Pokušaji prijave (ograničenje broja pokušaja, zajedničko za sve procese poslužitelja).
/// Ključ: 'email:<adresa>', 'ip:<adresa>', 'portal-email:<adresa>'…
model LoginAttempt {
  id  String   @id @default(cuid())
  key String
  at  DateTime @default(now())

  @@index([key, at])
}

/// Dnevnik poslane e-pošte (račun, ponuda, predračun, otpremnica, knjigovođa, partner…).
model EmailLog {
  id        String      @id @default(cuid())
  companyId String
  /// Vrsta: invoice | quote | proforma | delivery | service | partner | accountant-zip | reminder | test
  kind      String
  /// Zapis na koji se odnosi (id računa, ponude, partnera…); null za probnu poruku.
  entityId  String?
  to        String
  cc        String?
  subject   String
  status    EmailStatus
  error     String?
  messageId String?
  sentBy    String?
  at        DateTime    @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, at])
  @@index([companyId, kind, entityId])
  @@index([to(ops: raw("gin_trgm_ops"))], type: Gin, map: "EmailLog_to_trgm_idx")
  @@index([subject(ops: raw("gin_trgm_ops"))], type: Gin, map: "EmailLog_subject_trgm_idx")
}

/// Korisnik portala za klijente — vezan uz partnera (kupca); zasebna prijava i sesija.
model PortalUser {
  id           String    @id @default(cuid())
  companyId    String
  partnerId    String
  email        String    @unique
  name         String?
  passwordHash String
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company       Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  partner       Partner         @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  sessions      PortalSession[]
  serviceOrders ServiceOrder[]

  @@index([companyId])
  @@index([partnerId])
}

/// Sesija portala (kao Session: u bazi samo sha256 tokena).
model PortalSession {
  id           String    @id @default(cuid())
  portalUserId String
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  ip           String?
  userAgent    String?
  createdAt    DateTime  @default(now())

  portalUser PortalUser @relation(fields: [portalUserId], references: [id], onDelete: Cascade)

  @@index([portalUserId])
}

// =============================================================================
//  MDM — upravljanje uređajima (Android računala, Android handheldi, Windows)
//
//  Hijerarhija: firma vlasnik (SuperUser) → distributer → klijent → lokacija →
//  uređaji. Agent na uređaju se javlja preko /api/mdm/agent/* (prijava, javljanje
//  stanja, naredbe, rezultati, prijenos datoteka).
// =============================================================================

model MdmOrg {
  id        String     @id @default(cuid())
  companyId String
  parentId  String? // klijent distributera; null = izravno pod vlasnikom
  type      MdmOrgType
  name      String
  oib       String?
  email     String?
  phone     String?
  address   String?
  city      String?
  /// Veza na partnera u ERP-u (vidi samo vlasnik).
  partnerId String?
  active    Boolean    @default(true)
  note      String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  company      Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent       MdmOrg?          @relation("MdmOrgTree", fields: [parentId], references: [id], onDelete: Restrict)
  children     MdmOrg[]         @relation("MdmOrgTree")
  partner      Partner?         @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  sites        MdmSite[]
  devices      MdmDevice[]
  users        User[]
  profiles     MdmProfile[]
  apps         MdmApp[]
  files        MdmFile[]
  enrollTokens MdmEnrollToken[]

  @@index([companyId, type])
  @@index([parentId])
  @@index([partnerId])
}

model MdmSite {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  address   String?
  timezone  String   @default("Europe/Zagreb")
  /// Zadani profil za uređaje na lokaciji.
  profileId String?
  note      String?
  createdAt DateTime @default(now())

  org          MdmOrg           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  profile      MdmProfile?      @relation(fields: [profileId], references: [id], onDelete: SetNull)
  devices      MdmDevice[]
  enrollTokens MdmEnrollToken[]

  @@index([orgId])
  @@index([profileId])
}

model MdmDevice {
  id                   String          @id @default(cuid())
  companyId            String
  orgId                String?
  siteId               String?
  platform             MdmPlatform
  status               MdmDeviceStatus @default(PENDING)
  name                 String
  /// Šesteroznamenkasti kod koji agent prikazuje dok čeka upis.
  enrollCode           String?
  /// Sažetak tajnog ključa kojim se agent predstavlja.
  tokenHash            String          @unique
  serial               String?
  hardwareId           String? // Android ID / Windows UUID
  manufacturer         String?
  model                String?
  osVersion            String?
  agentVersion         String?
  imei                 String?
  macAddress           String?
  ipAddress            String?
  publicIp             String?
  wifiSsid             String?
  wifiSignal           Int? // dBm
  batteryLevel         Int?
  charging             Boolean?
  storageFreeMb        Int?
  storageTotalMb       Int?
  ramTotalMb           Int?
  uptimeSec            Int?
  /// Posljednje cjelovito stanje s uređaja (instalirane aplikacije, mreža…).
  telemetry            Json            @default("{}")
  lastSeenAt           DateTime?
  onlineSince          DateTime?
  enrolledAt           DateTime?
  profileId            String?
  /// Verzija konfiguracije koju je uređaj potvrdio; razlika = treba primijeniti.
  appliedConfigVersion Int             @default(0)
  configVersion        Int             @default(0)
  /// Konfiguracija samo za ovaj uređaj (nadjačava profil): kao MdmProfile.settings/apps.
  overrides            Json            @default("{}")
  maintenancePin       String?
  notes                String?
  itemId               String? // veza na uređaj u ERP skladištu
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  company  Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  org      MdmOrg?      @relation(fields: [orgId], references: [id], onDelete: SetNull)
  site     MdmSite?     @relation(fields: [siteId], references: [id], onDelete: SetNull)
  profile  MdmProfile?  @relation(fields: [profileId], references: [id], onDelete: SetNull)
  item     Item?        @relation(fields: [itemId], references: [id], onDelete: SetNull)
  commands MdmCommand[]
  events   MdmEvent[]
  uploads  MdmUpload[]

  @@index([companyId, status])
  @@index([orgId])
  @@index([siteId])
  @@index([profileId])
  @@index([itemId])
  @@index([companyId, serial])
  @@index([companyId, lastSeenAt])
  @@index([companyId, enrollCode])
  @@index([companyId, hardwareId])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "MdmDevice_name_trgm_idx")
  @@index([serial(ops: raw("gin_trgm_ops"))], type: Gin, map: "MdmDevice_serial_trgm_idx")
  @@index([imei(ops: raw("gin_trgm_ops"))], type: Gin, map: "MdmDevice_imei_trgm_idx")
}

/// Konfiguracija lokacije / skupine uređaja („Site Configuration").
model MdmProfile {
  id        String      @id @default(cuid())
  companyId String
  /// Vlasnik profila (distributer ili klijent); null = profil vlasnika sustava.
  orgId     String?
  name      String
  platform  MdmPlatform
  /// Postavke: { kiosk, restrictions{…}, adb, startApp, wifi[], pin, screenTimeoutSec, timezone, updatePolicy, … }
  settings  Json        @default("{}")
  /// Aplikacije: [{ appId, versionId?, config{k:v}, hidden, autoStart }]
  apps      Json        @default("[]")
  version   Int         @default(1)
  note      String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  company Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  org     MdmOrg?     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  sites   MdmSite[]
  devices MdmDevice[]

  @@index([companyId, orgId])
}

model MdmApp {
  id          String      @id @default(cuid())
  companyId   String
  orgId       String? // null = dostupna svima
  platform    MdmPlatform
  name        String
  packageName String // Android paket ili Windows ProductCode / naziv
  description String?
  /// Windows: argumenti tihe instalacije (npr. /qn za MSI).
  installArgs String?
  createdAt   DateTime    @default(now())

  company  Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  org      MdmOrg?         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  versions MdmAppVersion[]

  @@unique([companyId, platform, packageName, orgId])
  @@index([companyId, orgId])
}

model MdmAppVersion {
  id          String   @id @default(cuid())
  appId       String
  version     String
  versionCode Int?
  fileId      String
  notes       String?
  createdAt   DateTime @default(now())

  app  MdmApp  @relation(fields: [appId], references: [id], onDelete: Cascade)
  file MdmFile @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@unique([appId, version])
  @@index([fileId])
}

/// Datoteke (APK, MSI, EXE, dokumenti, snimke zaslona, zapisnici) — sadržaj na disku.
model MdmFile {
  id         String   @id @default(cuid())
  companyId  String
  orgId      String?
  kind       String // APP, FILE, DOC, SCREENSHOT, LOGS
  name       String
  mime       String
  size       Int
  sha256     String
  storageKey String   @unique
  createdBy  String?
  createdAt  DateTime @default(now())

  company     Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  org         MdmOrg?         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  appVersions MdmAppVersion[]
  uploads     MdmUpload[]

  @@index([companyId, kind])
  @@index([orgId])
}

model MdmCommand {
  id        String           @id @default(cuid())
  deviceId  String
  /// REBOOT, FORGET, APPLY_CONFIG, INSTALL_APP, UNINSTALL_APP, SCREENSHOT, UPLOAD_LOGS,
  /// LOCK, WIPE, MESSAGE, PUSH_FILE, RUN_SCRIPT, SET_KIOSK
  type      String
  payload   Json             @default("{}")
  status    MdmCommandStatus @default(PENDING)
  result    Json?
  error     String?
  createdBy String?
  createdAt DateTime         @default(now())
  sentAt    DateTime?
  doneAt    DateTime?
  expiresAt DateTime?

  device MdmDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, status])
  @@index([deviceId, createdAt])
}

/// Povijest uređaja: javljanja, promjene stanja, upozorenja, zapisi agenta.
model MdmEvent {
  id       String   @id @default(cuid())
  deviceId String
  at       DateTime @default(now())
  level    String   @default("info") // info, warn, error
  type     String
  message  String
  data     Json?

  device MdmDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, at])
}

model MdmUpload {
  id       String   @id @default(cuid())
  deviceId String
  kind     String // SCREENSHOT, LOGS
  fileId   String
  at       DateTime @default(now())

  device MdmDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  file   MdmFile   @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([deviceId, kind, at])
  @@index([fileId])
}

/// Ključ za automatski upis (QR za Android, parametar instalacije za Windows).
model MdmEnrollToken {
  id        String    @id @default(cuid())
  companyId String
  orgId     String
  siteId    String?
  token     String    @unique
  label     String?
  maxUses   Int?
  uses      Int       @default(0)
  expiresAt DateTime?
  createdBy String?
  createdAt DateTime  @default(now())

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  org     MdmOrg   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  site    MdmSite? @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([siteId])
}
